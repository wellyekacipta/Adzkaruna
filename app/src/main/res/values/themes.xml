<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <color name="splash_green_background">#00796B</color>
    <color name="splash_green_dark">#004D40</color>

    <style name="Theme.DoaHarianMuslimin" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Native Window Background: Langsung hijau + logo Adzkaruna sejak frame pertama aplikasi dibuka -->
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:statusBarColor">@color/splash_green_background</item>
        <item name="android:navigationBarColor">@color/splash_green_dark</item>

        <!-- Android 12+ (API 31+) Splash Screen System Attributes -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_green_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/app_logo_kufi</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
    </style>
</resources>
